<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voice_translate_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="6dp">

    <!-- [X] Sleek Close Button -->
    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/voice_translate_close"
        android:scaleType="centerInside" />

    <!-- Unified Sleek Language Selector Pill: [ বাংলা ➔ English ▼ ] -->
    <LinearLayout
        android:id="@+id/btn_target_toggle"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/voice_translate_badge_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/tv_source_lang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="বাংলা"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_direction_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="➔"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_target_lang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="English"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_target_dropdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="▼"
            android:textSize="8sp" />
    </LinearLayout>

    <!-- Center Live Status / Translation Transcript / Clickable Preview -->
    <TextView
        android:id="@+id/tv_status_transcript"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical|start"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="4dp"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        android:text="@string/voice_translate_status_tap_mic"
        android:textSize="12.5sp" />

    <!-- [➔] Translate Typed Text Button (appears when text is typed in chat) -->
    <ImageButton
        android:id="@+id/btn_translate_text"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="4dp"
        android:visibility="gone"
        android:background="@drawable/voice_mic_button_background"
        android:src="@drawable/ic_arrow_right"
        android:contentDescription="@string/translate_text_button_desc"
        android:scaleType="centerInside" />

    <!-- [🎙️] Prominent Modern Microphone Button -->
    <ImageButton
        android:id="@+id/btn_mic"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/voice_mic_button_background"
        android:src="@drawable/sym_keyboard_voice_lxx"
        android:contentDescription="@string/voice_translate_mic"
        android:scaleType="centerInside" />

</LinearLayout>
