<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voice_translate_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- [X] Close Button -->
    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/voice_translate_close"
        android:scaleType="centerInside" />

    <!-- Source: 'বাংলা (BN)' -->
    <TextView
        android:id="@+id/tv_source_lang"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginStart="2dp"
        android:background="@drawable/voice_translate_badge_bg"
        android:gravity="center"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:text="@string/voice_translate_source_bn"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:singleLine="true" />

    <!-- Direction indicator '➔' -->
    <TextView
        android:id="@+id/tv_direction_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:gravity="center"
        android:text="➔"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Target language toggle: '[ EN | HI ]' -->
    <LinearLayout
        android:id="@+id/btn_target_toggle"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:background="@drawable/voice_translate_badge_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/tv_target_en"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_translate_target_en"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_target_divider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" | "
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_target_hi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_translate_target_hi"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Microphone button with active/listening state -->
    <ImageButton
        android:id="@+id/btn_mic"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/voice_mic_button_background"
        android:src="@drawable/sym_keyboard_voice_lxx"
        android:contentDescription="@string/voice_translate_mic"
        android:scaleType="centerInside" />

    <!-- Status / live transcript text view -->
    <TextView
        android:id="@+id/tv_status_transcript"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical|start"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:text="@string/voice_translate_status_tap_mic"
        android:textSize="12sp" />

</LinearLayout>
